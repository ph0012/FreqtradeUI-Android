<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de extração de dados (Android 12+). Espelha as regras de backup:
     credenciais seguras devem ser excluídas do backup em nuvem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="freqtrade_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="freqtrade_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
